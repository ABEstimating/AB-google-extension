{
  "manifest_version": 3,
  "name": "AB Google Plugin",
  "version": "1.3.0",
  "description": "Projects, contacts, campaigns, Outlook/Graph mailer.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "downloads",
    "identity"
  ],
  "host_permissions": [
    "https://outlook.office.com/*",
    "https://graph.microsoft.com/*",
    "https://*.sharepoint.com/*",
    "https://excel.office.com/*",
    "https://*.officeapps.live.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://*.sharepoint.com/*",
        "https://excel.office.com/*",
        "https://*.officeapps.live.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ab-estimating.pages.dev/*"
      ],
      "js": [
        "website-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.css",
        "panel.js",
        "xlsx.full.min.js",
        "logo.svg",
        "ab-logo-white-24h.png",
        "ab-logo-white-32h.png",
        "ab-logo-white-48h.png",
        "data/us_cities_min.json",
        "data/us_cities_min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
